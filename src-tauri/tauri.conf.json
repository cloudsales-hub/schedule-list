{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScheduleWidget",
  "version": "0.1.0",
  "identifier": "com.personal.schedulewidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "일정·할일 위젯",
        "url": "widget.html",
        "width": 300,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "resizable": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "quick",
        "title": "빠른 메모",
        "url": "quick.html",
        "width": 420,
        "height": 140,
        "center": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
