{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScheduleWidget",
  "version": "0.2.0",
  "identifier": "com.personal.schedulewidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "일정·할일 위젯",
        "url": "widget.html",
        "width": 300,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "create": false
      },
      {
        "label": "quick",
        "title": "빠른 메모",
        "url": "quick.html",
        "width": 420,
        "height": 140,
        "center": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": true,
        "visible": false,
        "create": false
      },
      {
        "label": "dashboard",
        "title": "내 일정·할일",
        "url": "dashboard.html",
        "width": 900,
        "height": 600,
        "center": true,
        "visible": false,
        "minWidth": 700,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMkYzRTU5NjI5MTg5RjUKUldUMWlaRmlXVDR2ZzA4bHkwSjQyYjZDblRLN0dLSUpaQ0lGdW81UC9RN292Uk5aVzJDd0w0YXoK",
      "endpoints": [
        "https://github.com/cloudsales-hub/schedule-list/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
